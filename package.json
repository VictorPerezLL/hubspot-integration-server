{
  "name": "hubspot-integration-server",
  "version": "1.0.0",
  "description": "Node.js server that receives webhooks from ecommerce and payment platforms and syncs them with HubSpot CRM",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "hubspot:find-contact": "node scripts/hubspot-find-contact.js"
  },
  "keywords": [
    "hubspot",
    "webhooks",
    "ecommerce",
    "crm",
    "integration",
    "payments"
  ],
  "author": "Víctor Manuel Pérez Peña",
  "license": "none",
  "dependencies": {
    "@hubspot/api-client": "^9.0.0",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "stripe": "^18.5.0",
    "winston": "^3.11.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.16",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
