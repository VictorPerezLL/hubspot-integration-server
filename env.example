HS_BASE_URL=https://api.hubapi.com
HS_PRIVATE_APP_KEY=your_hubspot_private_app_key
HS_TEST_PRIVATE_APP_KEY=your_hubspot_test_private_app_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Additional Stripe Accounts (optional)
STRIPE_SECRET_KEY_2=sk_test_your_second_stripe_secret_key
STRIPE_WEBHOOK_SECRET_2=whsec_your_second_webhook_secret
STRIPE_SECRET_KEY_3=sk_test_your_third_stripe_secret_key
STRIPE_WEBHOOK_SECRET_3=whsec_your_third_webhook_secret

# WooCommerce Configuration
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here
WOO_BASE_URL=https://your-wordpress-site.com
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret

# WooCommerce Multi-site Configuration
FR_WOO_BASE_URL=https://fr.your-site.com
FR_WOO_CONSUMER_KEY=ck_fr_consumer_key
FR_WOO_CONSUMER_SECRET=cs_fr_consumer_secret

DE_WOO_BASE_URL=https://de.your-site.com
DE_WOO_CONSUMER_KEY=ck_de_consumer_key
DE_WOO_CONSUMER_SECRET=cs_de_consumer_secret

INT_WOO_BASE_URL=https://int.your-site.com
INT_WOO_CONSUMER_KEY=ck_int_consumer_key
INT_WOO_CONSUMER_SECRET=cs_int_consumer_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret
PAYPAL_MODE=sandbox  # or 'live' for production

# Webhook Configuration
WEBHOOK_TIMEOUT=30000  # 30 seconds
WEBHOOK_RETRY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Security Configuration - IP Whitelist
ALLOWED_WEBHOOK_IPS=127.0.0.1,::1
ALLOWED_ADMIN_IPS=127.0.0.1,::1
TRUSTED_IPS=127.0.0.1,::1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50