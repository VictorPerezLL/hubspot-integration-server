HS_BASE_URL=https://api.hubapi.com
HS_PRIVATE_APP_KEY=your_hubspot_private_app_key
HS_TEST_PRIVATE_APP_KEY=your_hubspot_test_private_app_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Additional Stripe Accounts (optional)
STRIPE_SECRET_KEY_2=sk_test_your_second_stripe_secret_key
STRIPE_WEBHOOK_SECRET_2=whsec_your_second_webhook_secret
STRIPE_SECRET_KEY_3=sk_test_your_third_stripe_secret_key
STRIPE_WEBHOOK_SECRET_3=whsec_your_third_webhook_secret

# WooCommerce Configuration
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here
WOO_BASE_URL=https://your-wordpress-site.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info